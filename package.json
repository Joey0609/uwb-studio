{
  "name": "uwb-studio",
  "version": "1.1.0",
  "description": "UWB广播测距多串口工作台",
  "private": true,
  "main": "main/main.cjs",
  "author": "UWB Studio",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "verify:release": "node tools/verify-release.cjs"
  },
  "dependencies": {
    "serialport": "13.0.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "js-yaml": "4.1.0"
  },
  "build": {
    "appId": "local.uwb.studio",
    "productName": "UWB Studio",
    "asar": true,
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "artifactName": "UWB-Studio-Setup-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Joey0609",
        "repo": "uwb-studio",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "UWB-Studio-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UWB Studio",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Joey0609/uwb-studio.git"
  }
}
